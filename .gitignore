# ==========================================
# Root-level ignore: ignore everything except allowed folders
# ==========================================
/*
!/Day-1/
!/Day-2/
!/Day-3/
!/Day-4/
!/Day-5/
!/Todo app/
!.gitignore
!README.md

# ==========================================
# Ignore specific files and folders inside allowed projects
# ==========================================
# Dependencies
node_modules/

# Environment variables & credentials
.env
.env.*
*.env
passwords.txt
*password*.txt

# Build & distribution folders
.dist/
dist/

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
.node_modules